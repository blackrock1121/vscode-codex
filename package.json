{
  "name": "vscode-codex",
  "displayName": "Codex Copilot",
  "description": "Copilot 风格的 Codex 编程助手，复用本机 Codex 登录与订阅",
  "version": "0.1.144",
  "publisher": "blackrock1121",
  "icon": "media/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/blackrock1121/vscode-codex.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Programming Languages"
  ],
  "keywords": [
    "codex",
    "ai",
    "chat",
    "copilot"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:codex-chat.editor",
    "onWebviewPanel:codex-chat.notify",
    "onUri"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codex-chat",
          "title": "Codex Copilot",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "codex-chat": [
        {
          "id": "codex-chat.chatView",
          "name": "会话",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "codex-chat.newSession",
        "title": "Codex: 打开新会话",
        "icon": {
          "light": "media/icon-light.svg",
          "dark": "media/icon.svg"
        }
      },
      {
        "command": "codex-chat.showSessions",
        "title": "Codex: 查看会话历史",
        "icon": "$(history)"
      },
      {
        "command": "codex-chat.stop",
        "title": "Codex: 停止当前轮次",
        "icon": "$(stop-circle)"
      },
      {
        "command": "codex-chat.closeSession",
        "title": "Codex: 关闭当前会话标签页",
        "icon": "$(close)"
      },
      {
        "command": "codex-chat.focusInput",
        "title": "Codex: 聚焦输入框"
      },
      {
        "command": "codex-chat.addSelectionToChat",
        "title": "Codex: 添加选中代码"
      },
      {
        "command": "codex-chat.openInEditor",
        "title": "Codex: 在编辑器右侧打开",
        "icon": "$(link-external)"
      },
      {
        "command": "codex-chat.checkUpdate",
        "title": "Codex: 检查更新",
        "icon": "$(sync)"
      },
      {
        "command": "codex-chat.open",
        "title": "Codex: 打开新会话",
        "icon": {
          "light": "media/icon-light.svg",
          "dark": "media/icon.svg"
        }
      },
      {
        "command": "codex-chat.notifyConfig",
        "title": "Codex: 任务推送配置",
        "icon": "$(bell)"
      },
      {
        "command": "codex-chat.performanceReport",
        "title": "Codex: 打开插件诊断中心"
      },
      {
        "command": "codex-chat.startDiagnostics",
        "title": "Codex: 开始插件诊断"
      },
      {
        "command": "codex-chat.openDiagnostics",
        "title": "Codex: 查看诊断记录"
      },
      {
        "command": "codex-chat.openLogs",
        "title": "Codex: 打开日志文件夹"
      },
      {
        "command": "codex-chat.resetLocalSnapshotExcludes",
        "title": "Codex: 清除当前工作区的本机快照排除记录"
      },
      {
        "command": "codex-chat.reopenClosedSession",
        "title": "Codex: 重新打开刚关闭的会话"
      },
      {
        "command": "codex-chat.login",
        "title": "Codex: 登录账号"
      },
      {
        "command": "codex-chat.account",
        "title": "Codex: 查看账号状态"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "codex-chat.openInEditor",
          "when": "view == codex-chat.chatView",
          "group": "navigation@0"
        },
        {
          "command": "codex-chat.checkUpdate",
          "when": "view == codex-chat.chatView",
          "group": "navigation@1"
        },
        {
          "command": "codex-chat.notifyConfig",
          "when": "view == codex-chat.chatView",
          "group": "navigation@5"
        }
      ],
      "editor/title": [
        {
          "command": "codex-chat.closeSession",
          "when": "activeWebviewPanelId == 'codex-chat.editor'",
          "group": "navigation@0"
        },
        {
          "command": "codex-chat.open",
          "when": "resourceScheme == file",
          "group": "navigation@9"
        },
        {
          "command": "codex-chat.newSession",
          "when": "activeWebviewPanelId == 'codex-chat.editor'",
          "group": "navigation@0"
        }
      ],
      "editor/context": [
        {
          "command": "codex-chat.addSelectionToChat",
          "when": "editorHasSelection",
          "group": "codex@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "codex-chat.focusInput",
        "key": "ctrl+shift+i",
        "mac": "cmd+shift+i"
      },
      {
        "command": "codex-chat.addSelectionToChat",
        "key": "ctrl+shift+l",
        "mac": "cmd+shift+l",
        "when": "editorHasSelection"
      },
      {
        "command": "codex-chat.reopenClosedSession",
        "key": "ctrl+shift+t",
        "mac": "cmd+shift+t",
        "when": "activeWebviewPanelId == 'codex-chat.editor' || focusedView == 'codex-chat.chatView'"
      }
    ],
    "configuration": {
      "title": "Codex Chat",
      "properties": {
        "codexChat.codexPath": {
          "type": "string",
          "default": "codex",
          "description": "Codex CLI 路径；默认从 PATH、Homebrew、~/.local/bin 和 nvm 安装位置查找。"
        },
        "codexChat.model": {
          "type": "string",
          "default": "",
          "description": "新会话的默认模型 ID；留空使用 Codex 默认值。会话内选择独立保存，仅影响该会话下一轮。选择器通过 model/list 获取账号可用模型。"
        },
        "codexChat.permissionMode": {
          "type": "string",
          "enum": [
            "default",
            "acceptEdits",
            "plan",
            "bypassPermissions"
          ],
          "default": "default",
          "enumDescriptions": [
            "只读沙箱，需要写入或提权时由用户审批",
            "允许工作区内写入，额外权限仍需审批",
            "只读，不允许提权",
            "完全访问，跳过审批"
          ],
          "description": "default：只读沙箱，按需审批；acceptEdits：允许工作区写入；plan：只读且不提权；bypassPermissions：完全访问。"
        },
        "codexChat.effort": {
          "type": "string",
          "enum": [
            "",
            "none",
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh",
            "max",
            "ultra"
          ],
          "default": "medium",
          "description": "新会话的默认推理强度为 medium；会话内选择独立保存，仅影响该会话下一轮。留空使用模型默认值，可用档位取决于模型。"
        },
        "codexChat.snapshotFilesForRestore": {
          "type": "boolean",
          "default": true,
          "description": "每轮开始前捕获工作区文本文件基线，用于查看差异和回滚。"
        },
        "codexChat.snapshotExclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "description": "不纳入文件回滚快照的项目相对路径规则，支持 * 和 **，例如 [\"coverage/**\", \"**/*.log\"]。排除后“还原到此处”也不能恢复这些文件。"
        },
        "codexChat.autosave": {
          "type": "boolean",
          "default": true,
          "description": "每轮发送前保存工作区中已打开的未保存文件，避免 Codex 读到旧内容；保存失败则取消发送。"
        },
        "codexChat.modEnterToSend": {
          "type": "boolean",
          "default": false,
          "description": "用 Cmd/Ctrl+Enter 发送、Enter 换行（默认 Enter 发送、Shift+Enter 换行）。切换后新打开的会话生效。"
        },
        "codexChat.prespawnOnOpen": {
          "type": "boolean",
          "default": true,
          "description": "打开聊天时提前连接 Codex、读取模型列表；已有会话同时恢复，空白聊天在发送时才创建会话，不主动发送模型预热请求。"
        },
        "codexChat.turnStallTimeoutSec": {
          "type": "number",
          "default": 720,
          "minimum": 60,
          "description": "持续没有事件的超时时间（秒），达到后重置连接；等待用户审批或压缩上下文期间不计时。"
        },
        "codexChat.transportDiagnostics": {
          "type": "boolean",
          "default": true,
          "description": "采集每轮准备、模型响应、工具/Bash、压缩、子 Agent、审批等待及传输耗时到本机日志，可通过“Codex: 打开插件诊断中心”查看。不保存提示词、完整命令、工具输出、图片内容或凭据。仅为该子进程覆盖 OTel 日志/指标导出地址，不修改全局配置，不开启已禁用的 analytics。已有自定义 OTel 导出需求时可关闭；下次连接生效。"
        },
        "codexChat.compactionMode": {
          "type": "string",
          "enum": [
            "balanced",
            "session"
          ],
          "default": "balanced",
          "enumDescriptions": [
            "仅 Astra 会话使用已验证的 Sol xhigh 优化原生自动及手动压缩；Sol、Luna 和未知家族沿用会话。",
            "压缩沿用会话模型与原生输入，关闭插件的压缩优化。"
          ],
          "description": "平衡模式优化官方提供方的原生自动及手动压缩：较旧的长工具输出先完整归档到本机，再使用原文摘录或重复引用；最近两轮和最近八个工具结果不做前置精简。原生压缩仍可能丢失细节。不改触发阈值，普通/快速档位严格沿用本轮。无法归档或还原增量历史时保留原输入；账号能力不足或自定义网关不接管，手动压缩保留兼容优化。下次连接生效。"
        },
        "codexChat.executionMode": {
          "type": "string",
          "enum": [
            "parallel",
            "tools",
            "standard"
          ],
          "default": "parallel",
          "enumDescriptions": [
            "智能并行：独立工具批量执行，适合时主动委派最多 2 个子 Agent。子 Agent 可能增加额度消耗。",
            "工具并行：批量执行独立检查，子 Agent 按用户或项目指令使用。",
            "原生策略：不追加插件的执行效率指令。"
          ],
          "description": "所有会话的执行调度策略，下次连接会话时生效。并行模式同时提供执行前检查、按原因处理失败和避免重复验证的指令；不更换模型、推理档位或收费档位，也不绕过权限。实际调度取决于模型与工具能力。"
        },
        "codexChat.appendSystemPrompt": {
          "type": "string",
          "default": "",
          "description": "追加给 Codex 的开发者指令，项目指令使用 AGENTS.md。"
        },
        "codexChat.notifyWebhook": {
          "type": "string",
          "default": "",
          "description": "任务推送的 webhook 地址（长任务完成、诊断结束，以及 Codex 停下来等你输入时提醒）。填飞书/企业微信/钉钉群机器人的 webhook 可直接收到文本消息；其他地址会收到通用 JSON（{text, isError, durationMs, project, question}，等待输入推送另带 waiting:true 与 ask）。留空关闭推送。"
        },
        "codexChat.notifyMinDurationSec": {
          "type": "number",
          "default": 60,
          "minimum": 0,
          "description": "任务或诊断执行时长达到该秒数才推送完成通知（默认 60 秒）；等待输入的提醒同用此阈值——距你上次操作超过该秒数才推。"
        },
        "codexChat.fastMode": {
          "type": "boolean",
          "default": false,
          "description": "旧版快速开关，仅用于兼容。",
          "deprecationMessage": "请改用 codexChat.speedMode 快速模式开关；尚未设置新选项时仍兼容此旧值。"
        },
        "codexChat.speedMode": {
          "type": "string",
          "enum": [
            "default",
            "fast"
          ],
          "default": "default",
          "enumDescriptions": [
            "普通：订阅内额度 1×。",
            "快速：官方已列模型订阅内额度 2.5×；需当前账号模型列表提供该档位。"
          ],
          "description": "新会话的默认速度模式（普通/快速）；会话内选择独立保存，仅影响该会话下一轮，不改变模型与推理强度。API 按服务档位单独定价，不适用订阅倍率。新设置优先于旧 fastMode 设置。"
        },
        "codexChat.notifyLocal": {
          "type": "boolean",
          "default": false,
          "description": "额外发送 macOS 本机系统通知，点击返回对应 VS Code 窗口和 Codex 会话或诊断记录。默认关闭；与飞书等 webhook 推送独立，不会替代或关闭飞书提醒。首次使用需允许系统通知；仅支持本机 macOS 扩展宿主。"
        },
        "codexChat.notifyUsageThresholdPct": {
          "type": "number",
          "default": 98,
          "minimum": 1,
          "maximum": 100,
          "description": "每周限额已使用百分比达到此值时发送用量预警；同一重置周期、同一渠道只成功通知一次。"
        },
        "codexChat.notifyUsageFeishu": {
          "type": "boolean",
          "default": true,
          "description": "达到每周用量预警阈值时，通过 codexChat.notifyWebhook 发送飞书等远程通知；须填写 webhook 地址。"
        },
        "codexChat.notifyUsageLocal": {
          "type": "boolean",
          "default": false,
          "description": "达到每周用量预警阈值时发送 macOS 本机通知，点击打开通知配置页；与任务通知的本机开关独立。"
        },
        "codexChat.notifyFeishuQuietHours": {
          "type": "object",
          "default": {
            "enabled": false,
            "start": "08:30",
            "end": "18:00"
          },
          "additionalProperties": false,
          "required": [
            "enabled",
            "start",
            "end"
          ],
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false,
              "description": "须先开启本机通知，才可在中国大陆工作日的指定时段暂停飞书推送（含调休上班日）。"
            },
            "start": {
              "type": "string",
              "default": "08:30",
              "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$",
              "description": "北京时间开始时刻，含此时刻。"
            },
            "end": {
              "type": "string",
              "default": "18:00",
              "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$",
              "description": "北京时间结束时刻，到此时刻恢复推送；须晚于开始时刻，不跨天。"
            }
          },
          "description": "可选飞书静默时段，默认关闭；仅当 codexChat.notifyLocal 已开启时生效，关闭本机通知后飞书照常推送。每日联网更新中国大陆节假日与调休，失败使用七天内缓存，无有效日历则照常推送。静默提醒不补发，手动测试不受限制。"
        },
        "codexChat.compactionModel": {
          "type": "string",
          "default": "auto",
          "description": "压缩目标：auto 从账号模型目录及官方升级关系发现后继 Sol，验证通过后采用。也可指定目录中的 Sol 模型 ID，但仍须通过验证，且不能为 Sol/Luna 会话升级模型。未知、不可用或未验证时沿用会话。下次连接生效。"
        },
        "codexChat.compactionAutoValidate": {
          "type": "boolean",
          "default": true,
          "description": "空闲时对新 Sol 候选执行一次合成历史验证，会额外消耗额度，不使用真实会话。所有窗口每天合计最多一个候选，最多四个生成请求、180 秒，普通收费档位；通过后缓存，失败不自动重复。关闭后仍可使用既有验证记录。下次连接生效。"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.js --production",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "check-types": "tsc --noEmit",
    "package": "npm run build:native && vsce package --no-dependencies --out release/vscode-codex.vsix",
    "test": "npm run build && node scripts/build-test.cjs && node --test test/*.test.cjs",
    "smoke": "node scripts/build-test.cjs && node scripts/smoke.cjs --turn",
    "smoke:question": "node scripts/build-test.cjs && node scripts/smoke-question.cjs",
    "build:native": "node scripts/build-native.cjs"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20.14.0",
    "@types/proxy-from-env": "1.0.4",
    "@types/vscode": "^1.90.0",
    "@types/ws": "8.18.2",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "highlight.js": "^11.10.0",
    "https-proxy-agent": "9.1.0",
    "jsdom": "^29.1.1",
    "markdown-it": "^14.1.0",
    "proxy-from-env": "2.1.0",
    "typescript": "^5.5.0",
    "ws": "8.22.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Codex 需要读取项目及执行工具，请先信任工作区。"
    }
  }
}
